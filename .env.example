# Copy this file to .env.local and fill in the values.
# On Vercel, add the same keys under Project Settings -> Environment Variables.

# --- Supabase (required) ------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps and routing --------------------------------------------------------
# The map itself uses OpenStreetMap tiles and needs no key.
# Road routes (real road geometry, distance, turn-by-turn steps, truck-aware
# routing for heavy vehicles) come from OpenRouteService:
#   https://openrouteservice.org/dev/#/api-keys   (free plan: 2,000 routes a day)
# Server-only: this key is never sent to the browser.
# Without it the map still works and shows the estimated city-to-city route.
ORS_API_KEY=

# --- AI providers (optional) --------------------------------------------------
# Order of use: Gemini -> Groq -> built-in deterministic writer.
# Groq key: https://console.groq.com/keys (this is Groq, not xAI Grok).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL==openai/gpt-oss-20b

# --- Weather (optional) -------------------------------------------------------
# Use ONE of these, or neither. Order tried: WeatherAPI.com, OpenWeather, then
# Open-Meteo, which needs no key. The two keys are not interchangeable.
#   WeatherAPI.com key:      https://www.weatherapi.com/my/
#   OpenWeatherMap key:      https://home.openweathermap.org/api_keys
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=

# --- Payments --------------------------------------------------------------------
# UPI id (VPA) that freight payments are sent to, e.g. yourname@okbank.
# It is shown to clients inside the payment QR code once a delivery is completed.
UPI_ID=

# --- App secrets ---------------------------------------------------------------
# Passcode for the hidden admin panel. Required in production.
ADMIN_PASSCODE=
# Signs the session cookie. Falls back to the service-role key when empty.
SESSION_SECRET=
